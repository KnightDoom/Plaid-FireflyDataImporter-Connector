# Copy this file to .env and replace every placeholder before running Compose.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=replace-me
PLAID_SECRET=replace-me
# PLAID_ITEMS_JSON is an object with an "items" array. Each item "key" is the
# bank key used by IMPORTER_DESTINATIONS_JSON. Each account ID maps to a
# Firefly account, ISO-4217 currency, and importer profile. Add
# "ignore_accounts": ["account-id"] on an item only when an account is not
# meant to be imported.
# {
#   "items": [{
#     "key": "bank-one",
#     "access_token": "replace-me",
#     "accounts": {
#       "plaid-account-id": {
#         "firefly_account_id": 1,
#         "currency": "CAD",
#         "importer_profile": "bank-one-chequing"
#       }
#     }
#   }]
# }
PLAID_ITEMS_JSON={"items":[{"key":"bank-one","access_token":"replace-me","accounts":{"replace-plaid-account-id":{"firefly_account_id":1,"currency":"CAD"}}}]}
FIREFLY_URL=http://host.docker.internal:8080
FIREFLY_TOKEN=replace-me
MODE=direct
DRY_RUN=true
LOG_LEVEL=INFO

# Required only when MODE=importer. This maps each PLAID_ITEMS_JSON item
# "key" (bank) to an absolute writable directory inside the container. The
# directory should be shared with Firefly III Data Importer.
# {"bank-one":"/exports/bank-one","bank-two":"/exports/bank-two"}
IMPORTER_DESTINATIONS_JSON={"bank-one":"/exports/bank-one"}
# IMPORTER_PROFILES_JSON maps each account's "importer_profile" name to a
# profile. Every profile needs the full exported Data Importer JSON in
# "importer_config" and a "csv" object with exactly one "external_id" column.
# CSV columns look like:
# {"header":"Date","field":"date"}
# {"header":"Currency","field":"currency_code"}
# {"header":"External ID","field":"external_id"}
# Replace the example below with compact, valid one-line JSON; do not include
# comments inside the JSON value.
# {
#   "bank-one-chequing": {
#     "importer_config": {"replace": "with exported Data Importer JSON"},
#     "csv": {
#       "delimiter": ";",
#       "columns": [
#         {"header": "Date", "field": "date"},
#         {"header": "Description", "field": "description"},
#         {"header": "Amount", "field": "amount"},
#         {"header": "Currency", "field": "currency_code"},
#         {"header": "External ID", "field": "external_id"}
#       ]
#     }
#   }
# }
IMPORTER_PROFILES_JSON={}

# Optional. The image defaults to /config/state.sqlite.
# IMPORT_START_DATE=2026-01-01
